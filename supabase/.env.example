# Local examples only. Copy to .env (ignored). Never put secret keys in web/ or the app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY to deployed functions.
UNFOLD_ENVIRONMENT=test
UNFOLD_ALLOWED_ORIGINS=http://localhost:8765
# Lemon Squeezy server is test-mode only. Register actual secrets in Supabase, never in Git.
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Enable only after both KRW and USD store/variant mappings are verified in public.lemon_prices.
UNFOLD_CHECKOUT_ENABLED=false
# Lemon Squeezy stores must use tax-exclusive pricing. Live catalog remains unconfigured.
