# Local examples only. Copy to .env (ignored). Never put secret keys in web/ or the app.
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# Supabase supplies SUPABASE_URL and SUPABASE_ANON_KEY to deployed functions.
UNFOLD_ENVIRONMENT=test
UNFOLD_ALLOWED_ORIGINS=http://localhost:8765
# Separate Test and Live credentials. Register actual secrets in Supabase, never in Git.
LEMONSQUEEZY_TEST_API_KEY=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_LIVE_API_KEY=
LEMONSQUEEZY_LIVE_WEBHOOK_SECRET=
# Enable after every market currently offered by the app has a verified mapping in public.lemon_prices.
# The first staged rollout offers KR only; GLOBAL remains unavailable until its own mapping is added.
UNFOLD_CHECKOUT_ENABLED=false
# Live catalog and prices.live_enabled must be configured before enabling checkout.
