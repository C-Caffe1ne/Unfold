+test('motion mounts visible home media, pins only on desktop, and cleans up on route and reduced-motion changes', async () => {
+  let reduced = false;
+  const listeners = {};
+  const contexts = [];
+  const reveals = [];
+  const pins = [];
+  const images = [{ hidden: false, closest: () => feature }];
+  const copy = { closest: () => feature };
+  const feature = {};
+  const home = {
+    id: 'home',
+    querySelectorAll: () => images,
+    querySelector: (selector) => selector === '.feature-demo-copy' ? copy : null,
+  };
+  const install = { id: 'install' };
+  const document = {
+    querySelector: () => home,
+    getElementById: (id) => ({ home, install })[id] || null,
+  };
+  const mediaQuery = (query) => ({
+    get matches() { return query.includes('reduce') ? reduced : true; },
+    addEventListener: (name, handler) => { listeners[`media:${query}`] = handler; },
+  });
+  const window = {
+    matchMedia: mediaQuery,
+    addEventListener: (name, handler) => { listeners[name] = handler; },
+  };
+  const gsap = {
+    registerPlugin() {},
+    context(callback, scope) {
+      callback();
+      const context = { scope, reverted: false, revert() { this.reverted = true; } };
+      contexts.push(context);
+      return context;
+    },
+    fromTo(target, from, to) { reveals.push({ target, from, to }); },
+  };
+  const ScrollTrigger = { create: (options) => pins.push(options) };
+  const path = join(__dirname, '../public/scripts/motion.js');
+  const moduleSource = readFileSync(path, 'utf8').replace(
+    "import { gsap, ScrollTrigger } from '/vendor/gsap.js';",
+    'const { gsap, ScrollTrigger } = globalThis.__unfoldMotionDependencies;',
+  );
+  const previous = { window: globalThis.window, document: globalThis.document, dependencies: globalThis.__unfoldMotionDependencies };
+  globalThis.window = window;
+  globalThis.document = document;
+  globalThis.__unfoldMotionDependencies = { gsap, ScrollTrigger };
+  try {
+    await import(`data:text/javascript;base64,${Buffer.from(moduleSource).toString('base64')}`);
+    assert.equal(reveals.length, 1);
+    assert.equal(reveals[0].target, images[0]);
+    assert.equal(images[0].hidden, false, 'motion never hides the source content');
+    assert.equal(pins.length, 1);
+    assert.equal(pins[0].pin, copy);
+    listeners['unfold:view-change']({ detail: { viewId: 'install' } });
+    assert.equal(contexts[0].reverted, true);
+    assert.equal(reveals.length, 1, 'non-home routes get no reveal animation');
+    listeners['unfold:view-change']({ detail: { viewId: 'home' } });
+    assert.equal(reveals.length, 2, 'returning home creates a fresh reveal context');
+    listeners['unfold:theme-change']();
+    assert.equal(contexts[1].reverted, true, 'theme preview changes dispose the old context');
+    assert.equal(reveals.length, 3);
+    reduced = true;
+    listeners['media:(prefers-reduced-motion: reduce)']();
+    assert.equal(contexts[2].reverted, true);
+    assert.equal(reveals.length, 3, 'reduced motion removes all active reveal and pin effects');
+  } finally {
+    if (previous.window === undefined) delete globalThis.window; else globalThis.window = previous.window;
+    if (previous.document === undefined) delete globalThis.document; else globalThis.document = previous.document;
+    if (previous.dependencies === undefined) delete globalThis.__unfoldMotionDependencies;
+    else globalThis.__unfoldMotionDependencies = previous.dependencies;
+  }
+});
