diff --git a/public/scripts/motion.js b/public/scripts/motion.js
new file mode 100644
index 0000000..8ebdc4c
--- /dev/null
+++ b/public/scripts/motion.js
@@ -0,0 +1,63 @@
+import { gsap, ScrollTrigger } from '/vendor/gsap.js';
+
+gsap.registerPlugin(ScrollTrigger);
+
+const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
+const desktopMotion = window.matchMedia('(min-width: 1100px)');
+let activeContext = null;
+let activeView = document.querySelector('[data-view]:not([hidden])');
+
+function clearMotion() {
+  activeContext?.revert();
+  activeContext = null;
+}
+
+function mountView(view) {
+  clearMotion();
+  activeView = view;
+  if (!view || view.id !== 'home' || reducedMotion.matches) return;
+
+  try {
+    activeContext = gsap.context(() => {
+      const images = view.querySelectorAll('.feature-media img:not([hidden]), .theme-preview img:not([hidden])');
+      images.forEach((image) => {
+        gsap.fromTo(image, { scale: 0.96, transformOrigin: '50% 50%' }, {
+          scale: 1,
+          duration: 0.7,
+          ease: 'power2.out',
+          scrollTrigger: {
+            trigger: image.closest('.feature-demo, .feature-media, .theme-preview') || image,
+            start: 'top 84%',
+            toggleActions: 'play none none reverse',
+            invalidateOnRefresh: true,
+          },
+        });
+      });
+
+      const copy = view.querySelector('.feature-demo-copy');
+      if (copy && window.matchMedia('(min-width: 1100px)').matches) {
+        ScrollTrigger.create({
+          trigger: copy.closest('.feature-demo') || copy,
+          pin: copy,
+          start: 'top top+=132',
+          end: '+=240',
+          pinSpacing: true,
+          anticipatePin: 1,
+        });
+      }
+    }, view);
+  } catch {
+    clearMotion();
+  }
+}
+
+window.addEventListener('unfold:view-change', (event) => {
+  mountView(document.getElementById(event.detail.viewId));
+});
+
+window.addEventListener('unfold:theme-change', () => mountView(activeView));
+
+reducedMotion.addEventListener('change', () => mountView(activeView));
+desktopMotion.addEventListener('change', () => mountView(activeView));
+
+mountView(activeView);
