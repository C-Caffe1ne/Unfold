<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsTestProject>true</IsTestProject><IsPackable>false</IsPackable><OutputType>Exe</OutputType></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Unfold.Desktop/Unfold.Desktop.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"><PrivateAssets>all</PrivateAssets></PackageReference>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.2" />
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Fixtures/*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../Art/Characters/bori-rabbit/runtime/bori-rabbit/*">
      <Link>Candidates/bori-rabbit/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../Art/Characters/bori-rabbit/source/bori-atlas-v1.png">
      <Link>Candidates/bori-source.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="../../Art/Characters/bori-rabbit/resource.json">
      <Link>Candidates/bori-resource.json</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
