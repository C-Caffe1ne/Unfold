<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Unfold.Desktop"
        x:Class="Unfold.Desktop.AccountWindow" x:DataType="local:AccountScreenModel" x:CompileBindings="True"
        Width="940" Height="620" MinWidth="640" MinHeight="560"
        Title="{Binding Copy.WindowTitle}" WindowStartupLocation="CenterScreen"
        WindowDecorations="None" Classes="unfold-page">
  <!-- Layout lives here; copy and display prices live in Assets/Account/entry-screen.json.
       Brushes refer to the same mutable theme tokens as the rest of the desktop app. -->
  <Window.Styles>
    <Style Selector="TextBlock.account-heading">
      <Setter Property="FontSize" Value="30" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Window.compact TextBlock.account-heading"><Setter Property="FontSize" Value="24" /></Style>
    <Style Selector="TextBlock.account-caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{x:Static local:DesignSystem.Muted}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Image.account-pet"><Setter Property="Width" Value="220" /><Setter Property="Height" Value="220" /></Style>
    <Style Selector="Window.compact Image.account-pet"><Setter Property="Width" Value="160" /><Setter Property="Height" Value="160" /></Style>
    <Style Selector="Button.account-primary"><Setter Property="Height" Value="48" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  </Window.Styles>
  <Grid>
  <Border Name="AccountFrame" Margin="12" Padding="24" CornerRadius="{x:Static local:DesignSystem.FrameRadius}"
          Background="{x:Static local:DesignSystem.Shell}" BorderBrush="{x:Static local:DesignSystem.Outline}" BorderThickness="1">
    <Grid RowDefinitions="Auto,24,*,20,Auto">
      <Grid Name="AccountDragHandle" ColumnDefinitions="*,Auto" Height="30" Background="Transparent">
        <Image Name="AccountBrandLogo" Width="110" Height="30" Stretch="Uniform"
               HorizontalAlignment="Left" VerticalAlignment="Center" AutomationProperties.Name="{Binding Content.Brand}" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <TextBlock Text="{Binding Step}" Classes="account-caption" VerticalAlignment="Center" />
          <Ellipse Width="7" Height="7" Fill="{x:Static local:DesignSystem.Accent}" />
          <Ellipse Width="7" Height="7" Fill="{x:Static local:DesignSystem.OutlineStrong}" Opacity="0.4" IsVisible="{Binding IsLogin}" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" ColumnDefinitions="*,24,*">
        <Border Name="AccountPetPanel" Background="{x:Static local:DesignSystem.Raised}" CornerRadius="{x:Static local:DesignSystem.CardRadius}" Padding="16">
          <Image Name="AccountCompanion" Classes="account-pet" Stretch="Uniform"
                 HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <ScrollViewer Name="AccountFormScroll" Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="AccountForm" Spacing="18" Margin="8,24" VerticalAlignment="Center">
            <TextBlock Text="{Binding Step}" Classes="account-caption" />
            <TextBlock Name="AccountHeading" Text="{Binding Heading}" Classes="account-heading" />
            <TextBlock Text="{Binding Email}" Classes="account-caption" IsVisible="{Binding IsPurchase}" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <StackPanel Spacing="8" IsVisible="{Binding IsPurchase}">
              <TextBlock Text="{Binding Copy.ProductLabel}" Classes="account-caption" />
              <TextBlock Name="AccountPrice" Text="{Binding Price}" FontSize="32" FontWeight="SemiBold" />
            </StackPanel>
            <TextBlock Name="AccountStatus" Text="{Binding Status}" Classes="account-caption" IsVisible="{Binding HasStatus}" />
            <Button Name="AccountPrimary" IsEnabled="{Binding CanPrimary}" Classes="unfold-action account-primary"
                    Classes.primary="{Binding IsPurchase}" Classes.quiet="{Binding IsLogin}">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Image Name="AccountGoogleIcon" Width="24" Height="24" Stretch="Uniform"
                       IsVisible="{Binding IsLogin}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding PrimaryText}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="AccountSecondary" Content="{Binding SecondaryText}" IsVisible="{Binding ShowSecondary}" Classes="unfold-action quiet" HorizontalAlignment="Stretch" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <Grid Grid.Row="4" ColumnDefinitions="*,16,Auto">
        <StackPanel Orientation="Horizontal" Spacing="16">
          <Button Name="AccountQuit" Content="{Binding Copy.QuitButton}" Classes="unfold-action quiet danger" />
          <TextBlock Text="{Binding Copy.Copyright}" Classes="account-caption" VerticalAlignment="Center" />
        </StackPanel>
        <Button Name="AccountCode" Grid.Column="2" IsVisible="{Binding ShowCode}" IsEnabled="{Binding CanRedeemCode}" Content="{Binding Copy.CodeButton}" Classes="unfold-action quiet" />
      </Grid>
    </Grid>
  </Border>
  <!-- Include the outer top margin as well as the header; no form controls occupy this band. -->
  <Border Name="AccountDragRegion" Height="90" VerticalAlignment="Top" Background="Transparent" />
  </Grid>
</Window>
